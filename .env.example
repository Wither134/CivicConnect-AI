# CivicConnect AI Environment Configuration
#
# SECURITY NOTE:
# By default, demo role switching is DISABLED in all environments.
# To temporarily preview role layouts in LOCAL DEVELOPMENT ONLY, set:
# VITE_ENABLE_DEMO_ROLE_SWITCHER=true
#
# In production builds, role switching is UNCONDITIONALLY DISABLED regardless of this setting.
# Visual role previews do NOT grant actual backend API authorization.

VITE_ENABLE_DEMO_ROLE_SWITCHER=false

