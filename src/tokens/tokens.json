{
  "colors": {
    "pageBackground": "#FBF6EF",
    "card": {
      "background": "#FFFFFF",
      "border": "#E9DFD3",
      "radius": "14px"
    },
    "text": {
      "ink": "#1E1B18",
      "muted": "#6A5D52"
    },
    "primary": {
      "rust": "#B03A0C",
      "selectedTint": "#FFF1E6"
    },
    "dark": {
      "band": "#1E1B18",
      "sidebar": "#1E1B18",
      "text": "#D9CEC2",
      "logoAccent": "#F4A582"
    },
    "resolved": {
      "teal": "#0F766E",
      "tint": "#D8F0EA",
      "text": "#0B5D54"
    },
    "dividers": "#EFE6DA",
    "inputBorder": "#D9C9B8",
    "statusPills": {
      "critical": {
        "background": "#FBE4E4",
        "text": "#8F1D1D"
      },
      "high": {
        "background": "#FDEBC8",
        "text": "#6B3E00"
      },
      "inProgress": {
        "background": "#FDEBC8",
        "text": "#6B3E00"
      },
      "resolved": {
        "background": "#D8F0EA",
        "text": "#0B5D54"
      },
      "underReview": {
        "background": "#E6EAF5",
        "text": "#2B3A67"
      },
      "medium": {
        "background": "#E6EAF5",
        "text": "#2B3A67"
      },
      "workCompleted": {
        "background": "#E6EAF5",
        "text": "#2B3A67"
      },
      "unverified": {
        "background": "#F3ECE1",
        "text": "#755C43"
      },
      "rejected": {
        "background": "#FCE8E6",
        "text": "#9E1C14"
      },
      "duplicate": {
        "background": "#EFEFEF",
        "text": "#505050"
      }
    },
    "roleBadges": {
      "citizen": {
        "background": "#F0EAE1",
        "text": "#554B43"
      },
      "staff": {
        "background": "#E0F2FE",
        "text": "#0369A1"
      },
      "admin": {
        "background": "#FFF1E6",
        "text": "#B03A0C"
      },
      "superAdmin": {
        "background": "#1E1B18",
        "text": "#FFFFFF"
      }
    }
  },
  "typography": {
    "fontFamilies": {
      "heading": "Fraunces, Georgia, serif",
      "body": "Inter, -apple-system, BlinkMacSystemFont, sans-serif"
    },
    "weights": {
      "heading": 600,
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "sizes": {
      "hero": "42px",
      "screenTitle": "26px",
      "cardTitle": "16px",
      "body": "14px",
      "bodyLarge": "15px",
      "meta": "12px"
    }
  },
  "controls": {
    "button": {
      "minHeight": "44px",
      "radius": "10px",
      "fontWeight": 600,
      "primaryBg": "#B03A0C",
      "primaryText": "#FFFFFF",
      "outlineBorder": "1.5px solid #B03A0C",
      "outlineText": "#B03A0C"
    },
    "input": {
      "height": "44px",
      "radius": "10px",
      "borderColor": "#D9C9B8"
    },
    "pill": {
      "radius": "20px",
      "fontSize": "12px",
      "fontWeight": 600
    },
    "progressBar": {
      "height": "6px",
      "radius": "3px"
    }
  },
  "constraints": {
    "minTouchTarget": "44px",
    "minContrastRatio": "4.5:1",
    "noShadows": true,
    "noGradients": true,
    "noEmoji": true,
    "borders": "1px solid"
  }
}

